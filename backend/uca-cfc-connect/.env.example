# Copia este archivo como .env (no se versiona) o exporta las variables en tu shell.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

DATABASE_URL=jdbc:postgresql://localhost:5432/uca_cfc_connect
DATABASE_USERNAME=cfc_app
DATABASE_PASSWORD=cfc_app_dev

JWT_SECRET=clave-local-de-al-menos-32-caracteres
JWT_ACCESS_MINUTOS=15
JWT_REFRESH_DIAS=7

# Correo real: activar un perfil distinto de dev (p. ej. prod) y configurar SMTP.
# Los valores se suministran mediante variables de entorno, no se versionan secretos.
# SPRING_PROFILES_ACTIVE=prod
# SPRING_MAIL_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@cfc.uca.edu.sv
# FRONTEND_URL=https://cfc.example.com
# SMTP_AUTH=true
# SMTP_STARTTLS=true
CORS_ORIGENES=http://localhost:3000,http://localhost:4200,http://localhost:5173
