    {
      "name": "02 - Autorizacion y errores",
      "item": [
        {
          "name": "Endpoint protegido sin token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Sin token responde 401', function () { pm.response.to.have.status(401); });\npm.test('Error de seguridad es JSON', function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); });"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Explicitly strip any Authorization header that may have been injected",
                  "// by a folder-level pre-request script or collection-level auth.",
                  "pm.request.headers.remove('Authorization');",
                  ""
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/cursos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "cursos"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Administrador consulta usuarios",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('ADMIN puede consultar usuarios', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/usuarios?page=0&size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "usuarios"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Cliente no puede consultar usuarios",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login cliente responde 200', function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set('clienteAccessToken', pm.response.json().accessToken);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Pre-request: ensure clienteAccessToken is populated before \"Cliente intenta consultar usuarios\"",
                  "// This runs before the CLIENTE login request itself, so nothing to do here.",
                  "// The login response test script stores clienteAccessToken.",
                  ""
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{clienteEmail}}\",\n  \"password\": \"{{clientePassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Cliente intenta consultar usuarios",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CLIENTE no puede consultar usuarios', function () { pm.response.to.have.status(403); });"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Ensure the clienteAccessToken is set before this request runs.",
                  "// The preceding \"Cliente no puede consultar usuarios\" request stores it,",
                  "// but if this request runs in isolation we need to fetch it here.",
                  "const clienteToken = pm.collectionVariables.get('clienteAccessToken');",
                  "if (!clienteToken) {",
                  "    const loginReq = {",
                  "        url: pm.collectionVariables.get('baseUrl') + '/api/v1/auth/login',",
                  "        method: 'POST',",
                  "        header: [{ key: 'Content-Type', value: 'application/json' }],",
                  "        body: {",
                  "            mode: 'raw',",
                  "            raw: JSON.stringify({",
                  "                email: pm.collectionVariables.get('clienteEmail'),",
                  "                password: pm.collectionVariables.get('clientePassword')",
                  "            })",
                  "        }",
                  "    };",
                  "    pm.sendRequest(loginReq, function (err, res) {",
                  "        if (err) { console.error('Cliente login failed:', err); return; }",
                  "        const body = res.json();",
                  "        if (body.accessToken) {",
                  "            pm.collectionVariables.set('clienteAccessToken', body.accessToken);",
                  "        } else {",
                  "            console.error('Cliente login: no accessToken in response', body);",
                  "        }",
                  "    });",
                  "}",
                  ""
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clienteAccessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "usuarios"
              ]
            }
          },
          "response": []
        }
      ],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 02 - Autorizacion y errores: folder pre-request",
              "// Ensures adminAccessToken is fresh so \"Administrador consulta usuarios\" works",
              "// when this folder is run independently.",
              "// Skips the login if a valid (non-empty) accessToken already exists.",
              "const existingToken = pm.collectionVariables.get('accessToken');",
              "if (!existingToken) {",
              "    const loginReq = {",
              "        url: pm.collectionVariables.get('baseUrl') + '/api/v1/auth/login',",
              "        method: 'POST',",
              "        header: [{ key: 'Content-Type', value: 'application/json' }],",
              "        body: {",
              "            mode: 'raw',",
              "            raw: JSON.stringify({",
              "                email: pm.collectionVariables.get('adminEmail'),",
              "                password: pm.collectionVariables.get('adminPassword')",
              "            })",
              "        }",
              "    };",
              "    pm.sendRequest(loginReq, function (err, res) {",
              "        if (err) { console.error('Admin login failed:', err); return; }",
              "        const body = res.json();",
              "        if (body.accessToken) {",
              "            pm.collectionVariables.set('accessToken', body.accessToken);",
              "            pm.collectionVariables.set('refreshToken', body.refreshToken || '');",
              "        } else {",
              "            console.error('Admin login: no accessToken in response', body);",
              "        }",
              "    });",
              "}",
              ""
            ]
          }
        }
      ]
    },
